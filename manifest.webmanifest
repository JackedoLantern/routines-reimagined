{
  "id": "./",
  "name": "Routines Reimagined",
  "short_name": "Routines",
  "description": "Daily workouts, routines, diet and Skeefo, your coach.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#09090A",
  "theme_color": "#09090A",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Today's workout", "short_name": "Workout", "url": "./#workout", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "My day", "short_name": "My day", "url": "./#day", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Diet", "short_name": "Diet", "url": "./#diet", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]},
    {"name": "Ask Skeefo", "short_name": "Skeefo", "url": "./#skeefo", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ],
  "widgets": [
    {
      "name": "Today in Routines",
      "short_name": "Today",
      "description": "Your level, streak, today's workout and what's left.",
      "tag": "today",
      "ms_ac_template": "widget/today.json",
      "data": "widget/data.json",
      "type": "application/json",
      "auth": false,
      "update": 900,
      "icons": [{"src": "icon-192.png", "sizes": "192x192"}],
      "screenshots": [{"src": "icon-512.png", "sizes": "512x512", "label": "Today widget"}]
    }
  ]
}
